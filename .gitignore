# Служебная папка Godot: кеш импорта, у каждого своя, в репозиторий не идёт.
.godot/
/android/
*.translation

# Сборки
/build/
/export/
*.exe
*.pck
*.x86_64
*.dmg
*.apk
*.zip

# --- Персональные данные (docs/decisions.md D-003) ---------------------------
# Реальные ФИО, должности и структура заказчика НИКОГДА не коммитятся.
# Игра читает их из внешней папки: godot --data-dir=/путь/к/реальным/данным
data/*.real.json
*.real.json
*.real.csv
/private-data/

# Записи прохождений для замера гипотезы: локальные, обезличенные,
# но в репозиторий им всё равно не надо.
/sessions/

# Исходники графики (большие). В репозиторий — только экспортированные PNG.
*.aseprite
*.ase
*.xcf
*.psd

# Генератор спрайтов (tools/art/): промежуточные картинки и кеш Python.
# В репозиторий идут только выбранные спрайты в assets/.
/art_out/
__pycache__/
*.pyc

# ОС и редакторы
.DS_Store
Thumbs.db
.vscode/
.idea/
*~
*.swp
