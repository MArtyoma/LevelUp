[layer_names]

2d_physics/layer_1="Стены и препятствия"
2d_physics/layer_2="Игрок"
2d_physics/layer_3="С чем можно взаимодействовать"

[levelup]

; Размеры всего, что видно на экране. Меняются здесь или в редакторе:
; Проект -> Настройки проекта -> Основные -> levelup/grid.
; Читаются кодом через src/core/grid.gd; там же написано, что делать после
; смены числа (перерисовать заглушки и пересобрать тайлсет).
;
; tile_size              размер тайла в пикселях: 16, 32, 64
; character_frame_*      размер одного кадра в спрайт-листе человека.
;                        Высота больше ширины - нормально: 16x32 значит,
;                        что голова торчит над линией тайла
; walk_frames            кадров в цикле ходьбы (колонок в листе)
; visible_tiles_*        сколько тайлов помещается на экран. Отсюда считается
;                        размер окна, поэтому при смене размера тайла игрок
;                        видит ровно столько же офиса

grid/tile_size=16
grid/character_frame_width=16
grid/character_frame_height=16
grid/walk_frames=4
grid/visible_tiles_x=30
grid/visible_tiles_y=17

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
