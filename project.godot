; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LevelUp"
config/description="Игра-симулятор онбординга: новый сотрудник осваивает структуру компании."
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
GameData="*res://src/autoload/game_data.gd"
QuestLog="*res://src/autoload/quest_log.gd"
DialogueRunner="*res://src/autoload/dialogue_runner.gd"
Telemetry="*res://src/autoload/telemetry.gd"
SaveGame="*res://src/autoload/save_game.gd"

[display]

; Эти четыре числа — то же самое, что levelup/grid ниже: 30x17 тайлов по 16
; пикселей. Godot читает их при открытии окна, до запуска кода; дальше размер
; пересчитывается в src/main.gd. Меняются вместе с grid, иначе окно на секунду
; откроется не того размера.
window/size/viewport_width=480
window/size/viewport_height=272
window/size/window_width_override=1440
window/size/window_height_override=816
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[file_customization]

folder_colors={
"res://assets/": "orange",
"res://data/": "green",
"res://src/levels/": "purple",
"res://src/ui/": "teal"
}

