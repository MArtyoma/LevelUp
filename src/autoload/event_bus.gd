extends Node

## Единственное место, через которое системы узнают друг о друге.
##
## Владелец: лид. Добавить сигнал — можно и нужно; удалить или переименовать — только
## сказав в чат, потому что на него кто-то подписан.
##
## Правило, ради которого шина существует: **система не знает, кто её слушает.**
## Квесты не знают про интерфейс, интерфейс не знает про диалоги, диалоги не знают
## про телеметрию. Каждый только кричит в шину и слушает её.
##
## Что это даёт конкретно нам: код пишут двое (лид — логика, artist — данные и
## интерфейс), и граница между ними проходит ровно здесь. Панель квестов artist
## подписывается на `quest_started` и не лезет в `QuestLog`; лид меняет внутренности
## `QuestLog` и не трогает ни одной сцены интерфейса. Файлы не пересекаются — Git
## не конфликтует.
##
## Чего в шине не должно быть: сигналов вида `player_moved` или чего угодно, что
## срабатывает каждый кадр. Шина — для событий, а не для потока данных.

# --- Диалоги -----------------------------------------------------------------

## Начался разговор. `speaker` — словарь сотрудника из GameData (имя, должность, отдел).
signal dialogue_started(dialogue_id: String, speaker: Dictionary)

## Показать реплику. Интерфейс рисует, логика к этому моменту уже всё решила.
signal dialogue_line_shown(text: String, speaker_name: String)

## Предложены варианты ответа. `choices` — массив словарей `{text, index}`.
## `time_limit` больше нуля только в дуэлях (D-002): интерфейс рисует полоску времени.
signal dialogue_choices_offered(choices: Array, time_limit: float)

## Дуэль: игрок промахнулся или не успел ответить. Терпение руководителя убавилось.
signal duel_patience_changed(left: int, total: int)

## Разговор закончился. `outcome` — "ok", "duel_won" или "duel_lost".
signal dialogue_finished(dialogue_id: String, outcome: String)

# --- Квесты ------------------------------------------------------------------

signal quest_started(quest_id: String)
signal quest_objective_completed(quest_id: String, objective_id: String)
signal quest_completed(quest_id: String)

# --- Мир и прогрессия --------------------------------------------------------

## Уровень пропуска вырос — открылись новые зоны (см. устав, «прогрессия завязана на пропуск»).
signal access_level_changed(level: int)

## Игрок ткнулся в дверь, которую его пропуск не открывает.
signal access_denied(required_level: int, current_level: int)

## Короткая подсказка в углу экрана: «Нажми E, чтобы поговорить».
signal hint_shown(text: String)
signal hint_hidden()

## Игрок вошёл в помещение. Нужно телеметрии: по этому событию видно, где он плутал.
signal room_entered(room_id: String)

## Прохождение закончено. `reason` — "completed" или "quit".
signal game_finished(reason: String)
